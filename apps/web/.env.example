# Plantilla de variables de entorno de apps/web.
# Copiar a apps/web/.env.local y reemplazar los valores.
# Los valores de este archivo son falsos a propósito: nunca subir secretos reales.
#
# Leyenda: [OBLIGATORIA] la función indicada no funciona sin ella.
#          [OPCIONAL]    tiene un valor por defecto.
#
# Las variables NEXT_PUBLIC_* se incrustan en el bundle del navegador: nunca poner secretos en ellas.

# ─── Públicas (visibles en el navegador) ──────────────────────────────────────
# [OPCIONAL] URL de la API usada por las páginas de partidos (por defecto http://localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:3001
# [OBLIGATORIA para el CAPTCHA] Site key pública de Cloudflare Turnstile.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=cambiar-por-la-site-key-de-turnstile

# ─── Solo servidor (proxy /api/backend) ───────────────────────────────────────
# [OBLIGATORIA] URL de la API a la que reenvía el proxy del servidor.
# Debe apuntar a la misma API que NEXT_PUBLIC_API_URL.
API_BASE_URL=https://api.ejemplo.invalid
# [OBLIGATORIA] Origen de este frontend; el proxy rechaza peticiones con otro Origin.
WEB_ORIGIN=http://localhost:3000
# [OBLIGATORIA] Secreto para firmar y validar los tokens CSRF.
# Generar con: openssl rand -base64 48
CSRF_SECRET=cambiar-por-un-valor-aleatorio-de-32-bytes
# NODE_TLS_REJECT_UNAUTHORIZED: no definirla. Si vale 0, el proxy se niega a funcionar.
# NODE_TLS_REJECT_UNAUTHORIZED=
