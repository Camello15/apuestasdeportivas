generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  TOTP_REENROLLMENT_REQUIRED
  DISABLED
}

enum EmailActionType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuditActorType {
  USER
  ADMINISTRATOR
  ANONYMOUS
  SYSTEM
}

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String              @db.VarChar(320)
  normalizedEmail      String              @unique @map("normalized_email") @db.VarChar(320)
  passwordHash         String              @map("password_hash") @db.VarChar(255)
  ageDeclared          Boolean             @map("age_declared")
  emailVerifiedAt      DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  status               UserStatus          @default(PENDING_EMAIL)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles            UserRole[]
  sessions             AuthSession[]
  emailActionTokens    EmailActionToken[]
  totpCredential       TotpCredential?
  totpRecoveryCodes    TotpRecoveryCode[]
  auditEvents          AuditEvent[]         @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(64)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(128)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuthSession {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  familyId    String              @map("family_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?            @map("revoke_reason") @db.VarChar(128)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshCredentials RefreshCredential[]

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model RefreshCredential {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @map("session_id") @db.Uuid
  digest      String      @unique @db.VarChar(128)
  jti         String      @unique @db.VarChar(64)
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?   @map("consumed_at") @db.Timestamptz(6)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(6)
  replacedBy  String?     @map("replaced_by") @db.Uuid
  session     AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("refresh_credentials")
}

model EmailActionToken {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        EmailActionType
  digest      String          @unique @db.VarChar(128)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?       @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt DateTime?     @map("invalidated_at") @db.Timestamptz(6)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("email_action_tokens")
}

model TotpCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  secretCiphertext      String    @map("secret_ciphertext") @db.Text
  keyVersion            String    @map("key_version") @db.VarChar(64)
  enabledAt             DateTime? @map("enabled_at") @db.Timestamptz(6)
  lastAcceptedTotpStep  BigInt?   @map("last_accepted_totp_step")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_credentials")
}

model TotpRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  digest     String    @unique @db.VarChar(128)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("totp_recovery_codes")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  actorId     String?        @map("actor_id") @db.Uuid
  actorType   AuditActorType @map("actor_type")
  action      String         @db.VarChar(128)
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ipAddress   String?        @map("ip_address") @db.VarChar(64)
  device      String?        @db.VarChar(512)
  targetType  String?        @map("target_type") @db.VarChar(64)
  targetId    String?        @map("target_id") @db.VarChar(128)
  metadata    Json?
  actor       User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_events")

  enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  SUSPENDED
  POSTPONED
  CANCELLED
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
  VOID
}

model Competition {
  id         String   @id @default(uuid()) @db.Uuid
  externalId Int?     @unique @map("external_id")
  name       String   @db.VarChar(160)
  country    String   @db.VarChar(100)
  sport      String   @default("FOOTBALL") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  matches    Match[]

  @@map("competitions")
}

model Match {
  id            String      @id @default(uuid()) @db.Uuid
  externalId    Int?        @unique @map("external_id")
  competitionId String      @map("competition_id") @db.Uuid
  homeTeam      String      @map("home_team") @db.VarChar(160)
  awayTeam      String      @map("away_team") @db.VarChar(160)
  startsAt      DateTime    @map("starts_at") @db.Timestamptz(6)
  status        MatchStatus @default(SCHEDULED)
  homeScore     Int?        @map("home_score")
  awayScore     Int?        @map("away_score")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  markets       Market[]

  @@index([status, startsAt])
  @@index([competitionId])
  @@map("matches")
}

model Market {
  id         String       @id @default(uuid()) @db.Uuid
  matchId    String       @map("match_id") @db.Uuid
  type       String       @db.VarChar(64)
  name       String       @db.VarChar(160)
  status     MarketStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  match      Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([matchId, status])
  @@map("markets")
}

model Selection {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String   @map("market_id") @db.Uuid
  code      String   @db.VarChar(64)
  label     String   @db.VarChar(160)
  odds      Decimal  @db.Decimal(10, 2)
  isWinner  Boolean? @map("is_winner")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, code])
  @@map("selections")
}
}
