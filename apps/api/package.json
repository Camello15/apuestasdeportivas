{
  "name": "@apuestas/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "admin:provision": "node dist/main.js provision-admin",
    "auth:seed": "node dist/main.js auth:seed",
    "audit:retention": "node dist/main.js audit:retention",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/client": "^6.19.3",
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "@zxcvbn-ts/language-en": "^4.1.2",
    "@zxcvbn-ts/language-es-es": "^4.1.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
