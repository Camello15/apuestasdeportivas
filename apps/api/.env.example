# Copiar a un archivo local ignorado por Git. No usar valores reales en este ejemplo.
DATABASE_URL=postgresql://AUTH_RUNTIME_USER:PASSWORD@localhost:5432/DATABASE
MIGRATION_DATABASE_URL=postgresql://AUTH_MIGRATION_USER:PASSWORD@localhost:5432/DATABASE
AUDIT_MAINTENANCE_DATABASE_URL=postgresql://AUTH_MAINTENANCE_USER:PASSWORD@localhost:5432/DATABASE
REDIS_URL=redis://localhost:6379
API_PORT=3001
# Exact number of trusted reverse-proxy hops; local/direct connections trust none.
TRUST_PROXY_HOPS=0
WEB_ORIGIN=https://localhost:3000
# Debe usar HTTPS y un certificado TLS de confianza para Node.js.
API_BASE_URL=https://localhost:3001
# Crear usuarios LOGIN separados fuera de la aplicación y concederles estos roles de grupo.
# AUTH_RUNTIME_USER debe ser miembro de auth_runtime; AUTH_MIGRATION_USER, de auth_migrator.
# auth_maintenance se reserva para el proceso de retención de auditoría futuro.

# HIBP Pwned Passwords: límites funcionales fijados por SPEC-002/plan.md.
HIBP_TIMEOUT_MS=3000
HIBP_MAX_RETRIES=1

# SMTP (sin credenciales de ejemplo); la aplicación falla cerrada si no está configurado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cloudflare Turnstile. La site key pública se configura en NEXT_PUBLIC_CAPTCHA_SITE_KEY en web.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
CAPTCHA_EXPECTED_HOSTNAME=

# RSA PEMs para tareas de autenticación posteriores; cargar desde gestor de secretos.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
# Optional overlap keyring during rotation; JSON map of kid to public PEM.
JWT_PUBLIC_KEYS=
JWT_ISSUER=
JWT_AUDIENCE=
# Secreto aleatorio de al menos 32 bytes; se usa como clave HMAC para digests de refresh.
REFRESH_TOKEN_PEPPER=
# Clave de cifrado TOTP de 32 bytes, representada como base64.
TOTP_ENCRYPTION_KEY=
TOTP_KEY_VERSION=v1
# During key rotation, provide old version keys as a JSON map until credentials are re-encrypted.
TOTP_ENCRYPTION_KEYS=
