# Plantilla de variables de entorno de apps/api.
# Copiar a apps/api/.env (o .env en la raíz) y reemplazar TODOS los valores.
# Los valores de este archivo son falsos a propósito: nunca subir secretos reales.
#
# Leyenda: [OBLIGATORIA] la API no arranca sin ella.
#          [CONDICIONAL] obligatoria solo si se usa la función indicada.
#          [OPCIONAL]    tiene un valor por defecto o puede quedar vacía.

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Crear usuarios LOGIN separados fuera de la aplicación y concederles estos roles:
# el usuario de DATABASE_URL debe ser miembro de auth_runtime; el de
# MIGRATION_DATABASE_URL, de auth_migrator; el de AUDIT_MAINTENANCE_DATABASE_URL,
# de auth_maintenance.

# [OBLIGATORIA] Conexión de la API en tiempo de ejecución. Debe empezar por postgres:// o postgresql://.
DATABASE_URL=postgresql://usuario-runtime-falso:cambiar-por-una-contrasena@localhost:5432/nombre-de-la-base
# [CONDICIONAL] Migraciones de Prisma y comandos auth:seed / provision-admin (reemplaza a DATABASE_URL en ellos).
MIGRATION_DATABASE_URL=postgresql://usuario-migracion-falso:cambiar-por-una-contrasena@localhost:5432/nombre-de-la-base
# [CONDICIONAL] Comando audit:retention (purga de registros de auditoría vencidos).
AUDIT_MAINTENANCE_DATABASE_URL=postgresql://usuario-mantenimiento-falso:cambiar-por-una-contrasena@localhost:5432/nombre-de-la-base

# ─── Redis ────────────────────────────────────────────────────────────────────
# [OBLIGATORIA] Contadores antiabuso y desafíos TOTP. Debe empezar por redis:// o rediss://.
REDIS_URL=redis://localhost:6379

# ─── Servidor y orígenes ──────────────────────────────────────────────────────
# [OPCIONAL] Puerto HTTP de la API (por defecto 3001).
API_PORT=3001
# [OPCIONAL] Número exacto de proxies inversos de confianza (entero de 0 a 5; por defecto 0).
# No dejarla vacía: si está definida debe ser un número.
TRUST_PROXY_HOPS=0
# [OBLIGATORIA] Origen del frontend (solo esquema://host:puerto). Usado en enlaces de correo.
# Debe usar HTTPS salvo en localhost.
WEB_ORIGIN=http://localhost:3000
# [OBLIGATORIA] Origen público de la API. Debe ser HTTPS, sin credenciales, query ni fragmento.
API_BASE_URL=https://api.ejemplo.invalid
# NODE_TLS_REJECT_UNAUTHORIZED: no definirla. Si vale 0, la API se niega a arrancar.
# NODE_TLS_REJECT_UNAUTHORIZED=

# ─── JWT y sesiones ───────────────────────────────────────────────────────────
# [CONDICIONAL] Si se define una clave JWT, deben definirse juntas: JWT_PRIVATE_KEY,
# JWT_PUBLIC_KEY, JWT_KEY_ID, JWT_ISSUER, JWT_AUDIENCE y REFRESH_TOKEN_PEPPER.
#
# Cómo generar el par de claves RSA (no pegar claves en este archivo):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Convertir cada PEM a una sola línea con \n literales para pegarlo en tu .env local:
#   awk 'NF {printf "%s\\n", $0}' jwt-private.pem
# Guardar los .pem fuera del repositorio o borrarlos después de usarlos.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Identificador (kid) de la clave actual: letras, números, _ o -.
JWT_KEY_ID=clave-ejemplo-1
JWT_ISSUER=emisor-de-ejemplo
JWT_AUDIENCE=audiencia-de-ejemplo
# [OPCIONAL] Claves públicas anteriores durante una rotación: JSON {"kid": "PEM en una línea"}.
JWT_PUBLIC_KEYS=
# [CONDICIONAL] Clave HMAC para los digests de refresh tokens. Mínimo 32 bytes.
# Generar con: openssl rand -base64 48
REFRESH_TOKEN_PEPPER=cambiar-por-un-valor-aleatorio-de-32-bytes

# ─── TOTP (segundo factor) ────────────────────────────────────────────────────
# [CONDICIONAL] Clave de cifrado de secretos TOTP: Base64 que decodifique a 32 bytes.
# Generar con: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# [CONDICIONAL] Versión de la clave actual; obligatoria si hay claves TOTP configuradas.
TOTP_KEY_VERSION=v1
# [OPCIONAL] Claves de versiones anteriores durante una rotación: JSON {"version": "base64"}.
TOTP_ENCRYPTION_KEYS=

# ─── Correo (SMTP) ────────────────────────────────────────────────────────────
# [CONDICIONAL] Necesario para verificación de correo y recuperación de contraseña;
# sin SMTP configurado, el envío falla de forma cerrada.
SMTP_HOST=smtp.ejemplo.invalid
# Puerto TCP válido (1-65535).
SMTP_PORT=587
# true o false (TLS directo).
SMTP_SECURE=false
SMTP_USER=usuario-smtp-falso
SMTP_PASSWORD=cambiar-por-la-contrasena-smtp
EMAIL_FROM=no-responder@ejemplo.invalid

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────────
# La site key pública va en NEXT_PUBLIC_CAPTCHA_SITE_KEY de apps/web.
# [OPCIONAL] Proveedor; el único valor aceptado es turnstile.
CAPTCHA_PROVIDER=turnstile
# [CONDICIONAL] Clave secreta de Turnstile.
CAPTCHA_SECRET_KEY=
# [CONDICIONAL] Hostname esperado en la respuesta del CAPTCHA; obligatorio si hay CAPTCHA_SECRET_KEY.
CAPTCHA_EXPECTED_HOSTNAME=

# ─── Have I Been Pwned (contraseñas filtradas) ───────────────────────────────
# [OPCIONAL] Valores fijados por la especificación: deben ser exactamente 3000 y 1.
HIBP_TIMEOUT_MS=3000
HIBP_MAX_RETRIES=1

# ─── Comandos de administración ───────────────────────────────────────────────
# [CONDICIONAL] Correo de una cuenta ya verificada a promover con: provision-admin.
ADMIN_PROVISION_EMAIL=admin@ejemplo.invalid
